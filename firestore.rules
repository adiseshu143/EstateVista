rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isAgent() {
      return isAuthenticated() && (getUserData().role == 'agent' || getUserData().role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Properties Collection
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAgent() && resource.data.agentId == request.auth.uid);
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if isAdmin() || (isAgent() && resource.data.assignedAgentId == request.auth.uid) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Leads Collection (Compatibility alias)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update: if isAdmin() || (isAgent() && resource.data.assignedAgentId == request.auth.uid) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Visits Collection
    match /visits/{visitId} {
      allow create: if true;
      allow read, update: if isAdmin() || (isAgent() && resource.data.assignedAgentId == request.auth.uid) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();

      // Favorites Subcollection
      match /favorites/{propertyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Locations Collection
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
